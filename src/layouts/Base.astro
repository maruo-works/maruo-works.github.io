---
import { Font, getImage } from 'astro:assets';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { OG_WIDTH, OG_HEIGHT } from '../lib/og';
import icon from '../assets/icon.jpg';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  /** 共有したときの画像（サイト内のパス）。なければサイト共通の画像 */
  image?: string;
  /** 検索エンジン向けの構造化データ（記事ページで渡す） */
  jsonLd?: Record<string, unknown>;
  /** 明朝をこのページに出てくる文字だけに絞る（文字の少ないページ向け。読む量が大きく減る） */
  fontSubset?: boolean;
}

const { title, description, type = 'website', image = '/og/site.png', jsonLd, fontSubset = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const favicon = await getImage({ src: icon, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: icon, width: 180, height: 180, format: 'png' });
// 日本語の書体は自分のサイトから配ると全ページに約250個の @font-face が入り遅くなる（速さ 97→68）ので Google から読む
const MINCHO_BASE = 'https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;500&display=swap';
// fontSubset のときは本文を先に描いて、出てくる文字だけを Google に頼む（text=）。足りない字があると別の書体で出るので、本文の文字から機械的に集める
let bodyHtml: string | null = null;
let MINCHO_URL = MINCHO_BASE;
if (fontSubset) {
  bodyHtml = await Astro.slots.render('default');
  const text = (bodyHtml + 'まるお')
    .replace(new RegExp('<script[^]*?</script>', 'gi'), '')
    .replace(new RegExp('<style[^]*?</style>', 'gi'), '')
    .replace(new RegExp('<[^>]+>', 'g'), '')
    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&nbsp;/g, ' ');
  const chars = [...new Set([...text].filter((c) => c.charCodeAt(0) > 32))].sort().join(''); // 全角の空白も含める（幅が変わらないように）
  MINCHO_URL = `${MINCHO_BASE}&text=${encodeURIComponent(chars)}`;
}

const person = { '@type': 'Person', name: SITE_TITLE, url: Astro.site!.href, sameAs: [GITHUB_URL] };
const structured = jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  description: SITE_DESCRIPTION,
  url: Astro.site!.href,
  inLanguage: 'ja',
  author: person,
};
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<slot name="head" />
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href={favicon.src}>
<link rel="apple-touch-icon" href={touchIcon.src}>
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content={SITE_TITLE}>
<meta property="og:locale" content="ja_JP">
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content={String(OG_WIDTH)}>
<meta property="og:image:height" content={String(OG_HEIGHT)}>
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href={MINCHO_URL} onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href={MINCHO_URL}></noscript>
<Font cssVariable="--font-courier" preload />
<script type="application/ld+json" set:html={JSON.stringify(structured)} />
</head>
<body>
<a class="name" href="/">まるお</a>
{bodyHtml !== null ? <Fragment set:html={bodyHtml} /> : <slot />}
<!-- アクセス解析（Cloudflare Web Analytics）。cookie を使わず、個人を特定しない。トークンは公開用。出し入れしたらプライバシーポリシーも直す -->
<script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "e3f12f3033104f118d88286a1639928b"}'></script>
</body>
</html>

<style is:global>
  :root {
    --white: #fff; --black: #0b0d14; --blue: #2b6fe0; --gray: #6b7079; --line: #e3e5ea;
    --font: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho", serif;
    --num: var(--font-courier);
    --ease: cubic-bezier(.3, .7, .2, 1);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font); font-weight: 400; color: var(--black); background: var(--white); line-height: 1.8; overflow-x: hidden; }
  a { color: inherit; }
  button { font: inherit; color: inherit; }
  img { max-width: 100%; height: auto; }

  .name { position: absolute; top: 20px; left: 24px; font-weight: 500; font-size: 17px; text-decoration: none; letter-spacing: .2em; }

  .btn {
    padding: 8px 26px; border-radius: 2px;
    border: 1px solid var(--black); background: var(--white); cursor: pointer;
    font-size: 13px; font-weight: 500; letter-spacing: .2em;
  }
  .btn:hover { background: var(--black); color: var(--white); }

  .link { text-decoration: none; border-bottom: 1px solid var(--blue); }
  .num { font-family: var(--num); }

  footer { text-align: center; color: var(--gray); font-size: 12px; padding: 16px 0 40px; letter-spacing: .1em; }
  footer p { margin: 0; }
  .credit { margin-top: 6px; font-size: 11px; color: var(--gray); }
</style>
