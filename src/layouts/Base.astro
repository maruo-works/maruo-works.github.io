---
import { getImage } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import icon from '../assets/icon.jpg';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
}

const { title, description, type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const favicon = await getImage({ src: icon, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: icon, width: 180, height: 180, format: 'png' });
const FONTS_URL = 'https://fonts.googleapis.com/css2?family=Shippori+Mincho+B1:wght@400;500&family=Courier+Prime&display=swap';
---
<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" type="image/png" href={favicon.src}>
<link rel="apple-touch-icon" href={touchIcon.src}>
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml">
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content={SITE_TITLE}>
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href={FONTS_URL} onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href={FONTS_URL}></noscript>
</head>
<body>
<a class="name" href="/">まるお</a>
<slot />
</body>
</html>

<style is:global>
  :root {
    --white: #fff; --black: #0b0d14; --blue: #2b6fe0; --gray: #6b7079; --line: #e3e5ea;
    --font: "Shippori Mincho B1", "Hiragino Mincho ProN", "Yu Mincho", serif;
    --num: "Courier Prime", "Courier New", monospace;
    --ease: cubic-bezier(.3, .7, .2, 1);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: var(--font); font-weight: 400; color: var(--black); background: var(--white); line-height: 1.8; overflow-x: hidden; }
  a { color: inherit; }
  button { font: inherit; color: inherit; }
  img { max-width: 100%; height: auto; }

  .name { position: absolute; top: 20px; left: 24px; font-weight: 500; font-size: 17px; text-decoration: none; letter-spacing: .2em; }

  .btn {
    padding: 8px 26px; border-radius: 2px;
    border: 1px solid var(--black); background: var(--white); cursor: pointer;
    font-size: 13px; font-weight: 500; letter-spacing: .2em;
  }
  .btn:hover { background: var(--black); color: var(--white); }

  .link { text-decoration: none; border-bottom: 1px solid var(--blue); }
  .num { font-family: var(--num); }

  footer { text-align: center; color: var(--gray); font-size: 12px; padding: 16px 0 40px; letter-spacing: .1em; }
  footer p { margin: 0; }
  .credit { margin-top: 6px; font-size: 11px; color: var(--gray); }
</style>
