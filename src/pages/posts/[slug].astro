---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE, GITHUB_URL, CONTACT_URL } from '../../consts';
import { formatDate } from '../../lib/date';
import { loadItems, monthKey, monthLabel } from '../../lib/items';
import { getPosts, readingMinutes } from '../../lib/posts';
import Takeaway from '../../components/article/Takeaway.astro';
import Compare from '../../components/article/Compare.astro';
import Side from '../../components/article/Side.astro';
import Steps from '../../components/article/Steps.astro';
import Sample from '../../components/article/Sample.astro';
import Cards from '../../components/article/Cards.astro';
import Card from '../../components/article/Card.astro';
import icon from '../../assets/icon.jpg';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, prev: posts[i - 1], next: posts[i + 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { posts } = await loadItems();
const no = posts.find((p) => p.href === `/posts/${post.id}/`)?.no;
const { title, description, takeaways, date, updated, time, draft } = post.data;
const minutes = readingMinutes(post.body);
const toc = headings.filter((h) => h.depth === 2);
const image = `/og/${post.id}.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  inLanguage: 'ja',
  image: new URL(image, Astro.site).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  author: { '@type': 'Person', name: SITE_TITLE, url: Astro.site!.href, sameAs: [GITHUB_URL] },
};
---
<Base title={`${title} - ${SITE_TITLE}`} description={description} type="article" image={image} jsonLd={jsonLd}>
<main>
<article class="card">
  <div class="head">
    <Image src={icon} width={112} height={112} alt="" />
    <div class="meta"><b>記事 ・ <span class="num">{no}</span>{draft && <span class="draft">下書き</span>}</b><br>{monthLabel(monthKey(date))}</div>
  </div>
  <h1>{title}</h1>
  <p class="sub">
    <span class="num">{formatDate(date)}</span>
    {updated && <span>（更新 <span class="num">{formatDate(updated)}</span>）</span>}
    <span class="sep">／</span>作業時間 {time}
    <span class="sep">／</span>約{minutes}分で読めます
  </p>

  {takeaways && takeaways.length > 0 && (
    <Takeaway>
      <ul>{takeaways.map((t) => <li>{t}</li>)}</ul>
    </Takeaway>
  )}

  {toc.length >= 3 && (
    <nav class="toc" aria-label="目次">
      <p class="toc-label">目次</p>
      <ol>
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </nav>
  )}

  <div class="post-body">
    <Content components={{ Compare, Side, Steps, Sample, Cards, Card }} />
  </div>

  {(prev || next) && (
    <nav class="pager" aria-label="前後の記事">
      {prev ? <a class="prev" href={`/posts/${prev.id}/`}><span>← 前の記事</span>{prev.data.title}</a> : <span />}
      {next ? <a class="next" href={`/posts/${next.id}/`}><span>次の記事 →</span>{next.data.title}</a> : <span />}
    </nav>
  )}

  <div class="foot">
    <p>お仕事の依頼：<a class="link" href="/work/">できること・依頼の流れ</a>　／　<a class="link" href={CONTACT_URL}>お問い合わせフォーム</a></p>
    <p><a class="link" href="/">← トップにもどる</a></p>
    <p class="credit">アイコンの写真は、AI（Grok Imagine）で生成しています</p>
    <p class="credit"><a href="/privacy/">プライバシーポリシー</a></p>
  </div>
</article>
</main>
</Base>

<style>
  .card { max-width: 560px; margin: 0 auto; padding: 96px 24px 48px; line-height: 2.1; }
  .head { display: flex; gap: 14px; align-items: center; padding-bottom: 16px; border-bottom: 1px solid var(--black); }
  .head img { width: 56px; height: 56px; object-fit: cover; }
  .meta { font-size: 12px; color: var(--gray); line-height: 1.6; }
  .meta b { color: var(--blue); font-weight: 500; letter-spacing: .2em; }
  .draft { margin-left: 10px; padding: 0 6px; border: 1px solid var(--blue); letter-spacing: .1em; }
  h1 { font-size: 24px; font-weight: 500; margin: 28px 0 4px; letter-spacing: .1em; line-height: 1.6; }
  .sub { font-size: 12px; color: var(--gray); margin: 0 0 28px; letter-spacing: .05em; line-height: 1.9; }
  .sep { margin: 0 .6em; }

  .toc { margin: 0 0 2.4em; padding: 12px 0 4px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .toc-label { margin: 0 0 4px; font-size: 12px; letter-spacing: .22em; color: var(--blue); font-weight: 500; }
  .toc ol { margin: 0 0 8px; padding-left: 1.6em; font-size: 14px; line-height: 2; }
  .toc li::marker { font-family: var(--num); color: var(--gray); }
  .toc a { text-decoration: none; }
  .toc a:hover { color: var(--blue); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 48px; }
  .pager a { display: block; padding: 12px 14px; border: 1px solid var(--line); text-decoration: none; font-size: 14px; line-height: 1.7; }
  .pager a:hover { border-color: var(--black); }
  .pager span { display: block; font-size: 11px; letter-spacing: .15em; color: var(--blue); }
  .pager .next { text-align: right; }
  @media (max-width: 560px) { .pager { grid-template-columns: 1fr; } }

  .foot { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 13px; color: var(--gray); }
  .foot a { color: var(--black); }

  /* 本文の標準の見た目。記事の部品の見た目が優先されるよう、詳細度を下げている */
  :where(.post-body) :global(p) { margin: 0 0 1.6em; }
  :where(.post-body) :global(h2) { font-size: 19px; font-weight: 500; margin: 2.4em 0 .8em; padding-bottom: 6px; border-bottom: 1px solid var(--line); letter-spacing: .08em; scroll-margin-top: 24px; }
  :where(.post-body) :global(h3) { font-size: 16px; font-weight: 500; margin: 2em 0 .6em; }
  :where(.post-body) :global(ul), :where(.post-body) :global(ol) { padding-left: 1.4em; margin: 0 0 1.6em; }
  :where(.post-body) :global(a) { text-decoration: none; border-bottom: 1px solid var(--blue); }
  :where(.post-body) :global(blockquote) { margin: 0 0 1.6em; padding: 2px 0 2px 16px; border-left: 2px solid var(--blue); color: #444; }
  :where(.post-body) :global(code) { font-family: var(--num); font-size: .9em; background: #f3f4f7; padding: 1px 5px; border-radius: 2px; }
  :where(.post-body) :global(pre) { overflow-x: auto; padding: 14px 16px; line-height: 1.7; border-radius: 2px; margin: 0 0 1.6em; }
  :where(.post-body) :global(pre code) { background: none; padding: 0; }
  :where(.post-body) :global(img) { display: block; margin: 0 auto 1.6em; }
  :where(.post-body) :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.4em 0; }
  :where(.post-body) :global(table) { border-collapse: collapse; width: 100%; margin: 0 0 1.6em; font-size: 14px; display: block; overflow-x: auto; }
  :where(.post-body) :global(th), :where(.post-body) :global(td) { border-bottom: 1px solid var(--line); padding: 6px 10px; text-align: left; }
</style>
