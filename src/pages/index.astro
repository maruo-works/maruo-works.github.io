---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SITE_TITLE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
import { monthTitles } from '../data/months';
import { formatDate } from '../lib/date';
import { loadItems, groupByMonth, monthKey, monthName, monthLabel, type MonthGroup } from '../lib/items';
import beachDay from '../assets/beach-day.jpg';
import beachEvening from '../assets/beach-evening.jpg';
import beachNight from '../assets/beach-night.jpg';
import discDay from '../assets/disc-day.jpg';
import discEvening from '../assets/disc-evening.jpg';
import discNight from '../assets/disc-night.jpg';

const { posts, works, all, latest, intro } = await loadItems();
const currentKey = monthKey(latest.date);
const [currentYear, currentMonth] = currentKey.split('-');
const currentTitle = monthTitles[currentKey];
const lastUpdated = latest.date;

const tabs: { id: string; label: string; groups: MonthGroup[] }[] = [
  { id: 'works', label: '実績', groups: groupByMonth(works) },
  { id: 'posts', label: '記事', groups: groupByMonth(posts) },
];
const countOf = (g: MonthGroup[]) => g.reduce((n, m) => n + m.items.length, 0);

const optimize = (src: ImageMetadata, width: number) => getImage({ src, width, format: 'webp', quality: 80 });
const jackets = {
  day: (await optimize(beachDay, 880)).src,
  evening: (await optimize(beachEvening, 880)).src,
  night: (await optimize(beachNight, 880)).src,
};
const discs = {
  day: (await optimize(discDay, 720)).src,
  evening: (await optimize(discEvening, 720)).src,
  night: (await optimize(discNight, 720)).src,
};
const alts = {
  day: '星の軌跡が残る青空の下、白い砂浜で燃える青い焚き火',
  evening: '日が沈んだ直後、星の軌跡の下の砂浜で燃える青い焚き火',
  night: '星の軌跡の下、白い砂浜で燃える青い焚き火',
};
---
<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
<div id="album">
  <div class="stage">
    <div class="case-box">
    <button class="case" type="button" aria-controls="booklet" aria-label="CDをひらく">
      <span class="tray"><span class="disc" id="disc"></span></span>
      <span class="lid">
        <span class="face front">
          <img id="jacket-img" width="880" height="880" alt="">
          <noscript><img src={jackets.night} width="880" height="880" alt={alts.night}></noscript>
          <span class="obi">
            <span class="v label num">{currentYear}.{currentMonth}</span>
            <span class="v copy">静かに、丁寧に、こつこつと。</span>
            <span class="v artist">まるお</span>
          </span>
        </span>
        <span class="face back">
          <span class="v big">{currentTitle ?? monthName(currentKey)}</span>
          <span class="v small">{currentTitle && <>{monthName(currentKey)}　</>}<b>まるお</b></span>
        </span>
      </span>
    </button>
    <a class="intro" href={intro.href} aria-label={`はじめに（${intro.title}）`}>はじめに</a>
    </div>
    <script is:inline define:vars={{ jackets, discs, alts }}>
      const forced = new URLSearchParams(location.search).get('t');
      const h = new Date().getHours();
      const t = jackets[forced] ? forced : h >= 6 && h < 17 ? 'day' : h >= 17 && h < 19 ? 'evening' : 'night';
      const img = document.getElementById('jacket-img');
      img.fetchPriority = 'high';
      img.src = jackets[t];
      img.alt = alts[t];
      document.getElementById('disc').style.backgroundImage = `url(${discs[t]})`;
    </script>

    <div class="booklet" id="booklet">
      <div class="booklet-clip" inert>
        <div class="sheet">
          <div class="sheet-head">
            <span class="month">{monthLabel(currentKey)}</span>
            <span class="count">つみあげ：{all.length}個</span>
          </div>
          <p class="latest"><b>最新</b>{latest.href ? <a class="link" href={latest.href}>{latest.title}</a> : <span>{latest.title}</span>}</p>

          <div class="tabs" role="tablist">
            {tabs.map((tab, i) => (
              <button class="tab" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
                {tab.label}<span class="n num">{countOf(tab.groups)}</span>
              </button>
            ))}
          </div>

          {tabs.map((tab, i) => (
            <div class="panel" id={`panel-${tab.id}`} role="tabpanel" aria-labelledby={`tab-${tab.id}`} hidden={i !== 0}>
              {tab.groups.length === 0 && <p class="empty">まだありません</p>}
              {tab.groups.map((group, gi) => (
                <details open={gi === 0}>
                  <summary><span class="m">{group.label}</span><span class="c">{group.items.length}個</span></summary>
                  <ol class="tracks">
                    {group.items.map((item) => (
                      <li>
                        <span class="no num">{item.no}</span>
                        {item.href
                          ? <a class="title" href={item.href}>{item.title}<span class="date num">{formatDate(item.date)}</span></a>
                          : <span class="title">{item.title}<span class="date num">{formatDate(item.date)}</span></span>}
                        <span class="time">{item.time}</span>
                      </li>
                    ))}
                  </ol>
                </details>
              ))}
            </div>
          ))}

          <div class="sheet-foot"><button class="btn close-btn" type="button" aria-controls="booklet">CDをとじる</button></div>
        </div>
      </div>
    </div>

    <div class="info-wrap">
      <div>
        <div class="info">
          <p class="month">{monthLabel(currentKey)}</p>
          <p class="latest"><b>最新</b>{latest.href ? <a class="link" href={latest.href}>{latest.title}</a> : <span>{latest.title}</span>}</p>
          <p class="count">つみあげ：{all.length}個</p>
          <button class="btn open-btn" type="button" aria-expanded="false" aria-controls="booklet">CDをひらく</button>
        </div>
      </div>
    </div>
  </div>

  <main>
    <section class="side">
      <h2>プロフィール</h2>
      <ul class="rows">
        <li><span>まるお</span><span>大学生</span></li>
        <li><span>はじめに</span><a class="link" href={intro.href}>{intro.title}</a></li>
      </ul>
    </section>

    <section class="side">
      <h2>連絡先</h2>
      <ul class="rows">
        <li><span>お仕事の依頼</span><span>お問い合わせ（準備中）</span></li>
        <li><span>GitHub</span><a class="link" href={GITHUB_URL}>maruo-works</a></li>
      </ul>
    </section>
  </main>
</div>

<footer>
  <p>© {currentYear} まるお　／　最終更新 <span class="num">{formatDate(lastUpdated)}</span></p>
  <p class="credit">ジャケットとCDの写真は、AI（Grok Imagine）で生成しています</p>
</footer>
</Base>

<script>
  const album = document.getElementById('album')!;
  const caseBtn = album.querySelector<HTMLButtonElement>('.case')!;
  const openBtn = album.querySelector<HTMLButtonElement>('.open-btn')!;
  const closeBtn = album.querySelector<HTMLButtonElement>('.close-btn')!;
  const clip = album.querySelector<HTMLElement>('.booklet-clip')!;
  const infoWrap = album.querySelector<HTMLElement>('.info-wrap > div')!;

  const setOpen = (open: boolean) => {
    album.classList.toggle('is-open', open);
    openBtn.setAttribute('aria-expanded', String(open));
    caseBtn.setAttribute('aria-label', open ? 'CDをとじる' : 'CDをひらく');
    clip.inert = !open;
    infoWrap.inert = open;
  };
  caseBtn.addEventListener('click', () => setOpen(!album.classList.contains('is-open')));
  openBtn.addEventListener('click', () => setOpen(true));
  closeBtn.addEventListener('click', () => {
    setOpen(false);
    caseBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  if (new URLSearchParams(location.search).get('open') === '1') setOpen(true);

  const tabs = album.querySelectorAll<HTMLButtonElement>('.tab');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    tabs.forEach((other) => {
      const on = other === tab;
      other.setAttribute('aria-selected', String(on));
      document.getElementById(other.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }));
</script>

<style>
  .stage { display: grid; justify-items: center; padding: 88px 16px 0; }

  /* 閉じるときは紙がしまわれてから、ふたが閉まる */
  .case-box {
    --w: min(440px, 86vw);
    position: relative; z-index: 2; width: var(--w); aspect-ratio: 1;
    container-type: inline-size;
    transition: transform .9s var(--ease) .45s, width .9s var(--ease) .45s;
  }
  .is-open .case-box { --w: min(400px, 44vw); transform: translateX(50%); transition-delay: 0s; }
  .case {
    position: absolute; inset: 0; width: 100%; height: 100%;
    perspective: 2200px;
    cursor: pointer; border: 0; padding: 0; background: none; display: block;
  }

  /* ふたの内側の左下。ふたが開き切ってから出て、閉じ始める前に消える */
  .intro {
    position: absolute; z-index: 1; left: -92%; bottom: 7%;
    writing-mode: vertical-rl; line-height: 1; white-space: nowrap;
    font-size: max(11px, 3cqw); letter-spacing: .3em; color: var(--gray);
    text-decoration: underline; text-decoration-color: var(--blue); text-underline-offset: .4em;
    padding: 4px;
    opacity: 0; visibility: hidden;
    transition: opacity .3s ease, visibility 0s linear .3s;
  }
  .intro:hover { color: var(--blue); }
  .is-open .intro { opacity: 1; visibility: visible; transition: opacity .4s ease .9s, visibility 0s linear .9s; }

  .tray {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #1a1e2a, var(--black) 60%);
    box-shadow: 0 18px 40px rgba(11,13,20,.28);
    display: grid; place-items: center;
  }
  .disc {
    width: 90%; aspect-ratio: 1; border-radius: 50%;
    background: center / cover no-repeat;
    -webkit-mask: radial-gradient(circle, transparent 0 6.5%, #000 7% 100%);
            mask: radial-gradient(circle, transparent 0 6.5%, #000 7% 100%);
    position: relative;
  }
  .disc::after {
    content: ""; position: absolute; inset: 0; border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 15%, rgba(255,255,255,.55) 15.5% 16.5%, transparent 17%),
      conic-gradient(from 30deg, rgba(255,255,255,0) 0deg, rgba(255,255,255,.22) 40deg, rgba(255,255,255,0) 90deg, rgba(255,255,255,0) 180deg, rgba(255,255,255,.18) 220deg, rgba(255,255,255,0) 270deg);
  }
  .is-open .disc { animation: spin 1.6s cubic-bezier(.2,.7,.2,1) .35s; }
  @keyframes spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }

  .lid {
    position: absolute; inset: 0;
    transform-origin: left center; transform-style: preserve-3d;
    transition: transform .9s var(--ease) .45s;
  }
  .is-open .lid { transform: rotateY(-180deg); transition-delay: 0s; }
  .face { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; container-type: inline-size; }
  .front { background: var(--black); box-shadow: 0 18px 40px rgba(11,13,20,.28); }
  .front img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .back {
    transform: rotateY(180deg);
    background: var(--white); border: 1px solid var(--line);
    box-shadow: 0 18px 40px rgba(11,13,20,.18);
    display: flex; flex-direction: row-reverse; justify-content: center; align-items: center; gap: 6cqw;
  }
  .back .v { writing-mode: vertical-rl; white-space: nowrap; letter-spacing: .2em; line-height: 1; }
  .back .big { font-size: 6.4cqw; font-weight: 500; letter-spacing: .3em; }
  .back .small { font-size: 3.2cqw; color: var(--gray); }
  .back .small b { color: var(--blue); font-weight: 500; }

  .obi {
    position: absolute; top: 0; bottom: 0; left: 0; width: 15%;
    background: var(--white);
    display: flex; flex-direction: column; align-items: center; justify-content: space-between;
    padding: 12px 0;
    box-shadow: 2px 0 6px rgba(11,13,20,.2);
  }
  .obi .v { writing-mode: vertical-rl; white-space: nowrap; letter-spacing: .12em; line-height: 1; }
  .obi .label { font-size: 2.2cqw; color: var(--gray); }
  .obi .copy { font-size: 3.4cqw; font-weight: 500; color: var(--blue); letter-spacing: .2em; }
  .obi .artist { font-size: 2.8cqw; font-weight: 500; letter-spacing: .2em; }

  /* 閉じているときの案内：開くと消えて、閉じ終わってから戻る */
  .info-wrap { display: grid; grid-template-rows: 1fr; transition: grid-template-rows .5s ease 1.2s, opacity .4s ease 1.3s; }
  .info-wrap > div { overflow: hidden; }
  .is-open .info-wrap { grid-template-rows: 0fr; opacity: 0; transition-delay: 0s, 0s; }
  .info { text-align: center; padding: 20px 0 8px; }
  .info .month { margin: 0; font-weight: 500; letter-spacing: .12em; }
  .latest { margin: 6px 0 0; font-size: 14px; }
  .latest b { color: var(--blue); font-weight: 500; margin-right: 8px; }
  .info .count { margin: 2px 0 16px; font-size: 13px; color: var(--gray); }

  /* ケースの下から引き出される紙 */
  .booklet {
    position: relative; z-index: 1;
    width: min(800px, 88vw);
    display: grid; grid-template-rows: 0fr;
    transition: grid-template-rows .8s var(--ease);
  }
  .is-open .booklet { grid-template-rows: 1fr; transition-delay: .6s; }
  .booklet-clip { overflow: hidden; padding: 0 14px 32px; margin: 0 -14px; min-height: 0; }
  .sheet {
    transform: translateY(-100%);
    transition-property: transform, visibility;
    transition-duration: .8s;
    transition-timing-function: var(--ease);
    transition-delay: 0s, .8s;
    background: linear-gradient(to bottom, rgba(11,13,20,.07), rgba(11,13,20,0) 18px), var(--white);
    border: 1px solid var(--line); border-top: 0;
    padding: 28px clamp(18px, 7vw, 120px);
    visibility: hidden;
  }
  .is-open .sheet {
    transform: translateY(0); visibility: visible; transition-delay: .6s, 0s;
    box-shadow: 0 14px 30px rgba(11,13,20,.12);
  }

  .sheet-head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; padding-bottom: 10px; border-bottom: 1px solid var(--black); }
  .sheet-head .month { font-weight: 500; letter-spacing: .12em; }
  .sheet-head .count { font-size: 13px; color: var(--gray); }
  .sheet .latest { margin: 12px 0 0; }

  .tabs { display: flex; margin-top: 24px; border-bottom: 1px solid var(--line); }
  .tab {
    flex: 1; padding: 10px 0; background: none; border: 0; border-bottom: 2px solid transparent;
    cursor: pointer; font-weight: 500; letter-spacing: .3em; color: var(--gray); margin-bottom: -1px;
  }
  .tab[aria-selected="true"] { color: var(--black); border-bottom-color: var(--blue); }
  .tab .n { font-size: 12px; margin-left: 4px; letter-spacing: 0; color: var(--gray); }
  .panel[hidden] { display: none; }
  .empty { color: var(--gray); font-size: 14px; padding: 14px 0; margin: 0; }

  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; padding: 14px 0;
    display: grid; grid-template-columns: 1fr auto 1.2em; gap: 8px; align-items: baseline;
  }
  summary::-webkit-details-marker { display: none; }
  summary .m { font-weight: 500; letter-spacing: .06em; }
  summary .c { font-size: 13px; color: var(--gray); }
  summary::after { content: "+"; font-family: var(--num); color: var(--blue); text-align: right; }
  details[open] summary::after { content: "−"; }

  .tracks { list-style: none; margin: 0 0 12px; padding: 0; }
  .tracks li { display: grid; grid-template-columns: 2.5em 1fr auto; gap: 8px; align-items: baseline; padding: 10px 0; border-top: 1px solid var(--line); }
  .tracks .no { font-size: 13px; color: var(--blue); }
  .tracks .title { font-weight: 500; text-decoration: none; }
  .tracks a.title:hover { color: var(--blue); }
  .tracks .date { display: block; font-size: 11px; color: var(--gray); font-weight: 400; }
  .tracks .time { font-size: 12px; color: var(--gray); }

  .sheet-foot { text-align: center; margin-top: 24px; }

  main { max-width: 560px; margin: 0 auto; padding: 24px 20px 48px; }
  .side { margin-top: 40px; }
  .side h2 { margin: 0 0 8px; font-size: 13px; letter-spacing: .3em; color: var(--blue); font-weight: 500; }
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--black); }
  .rows li { display: grid; grid-template-columns: 8em 1fr; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14px; }
  .rows li span:first-child { color: var(--gray); }
  .rows li a { justify-self: start; }

  @media (prefers-reduced-motion: reduce) {
    .case-box, .lid, .info-wrap, .booklet, .sheet, .intro { transition: none !important; }
    .is-open .disc { animation: none; }
  }
</style>
