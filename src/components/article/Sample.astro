---
/** 見本の枠。実際に書いた形をそのまま見せる。note は枠の下の小さな注記 */
interface Props {
  label?: string;
  note?: string;
}
const { label = '見本', note } = Astro.props;
---
<figure class="sample">
  <figcaption class="label">{label}</figcaption>
  <div class="body"><slot /></div>
  {note && <p class="note">{note}</p>}
</figure>

<style>
  .sample { margin: 0 0 2.4em; }
  .label { margin: 0 0 10px; font-size: 12px; letter-spacing: .22em; color: var(--blue); font-weight: 500; }
  .body { background: #f6f7f9; border-left: 2px solid var(--blue); padding: 16px 18px 4px; font-size: 14px; line-height: 1.85; }
  .body :global(p) { margin: 0 0 12px; }
  .body :global(strong) { font-weight: 500; }
  .note { margin: 8px 0 0; font-size: 12px; color: var(--gray); letter-spacing: .06em; }
</style>
